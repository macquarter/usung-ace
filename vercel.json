{
  "version": 2,
  "routes": [
    { "src": "/(.*)\\.php(/.*)?", "headers": { "Location": "/" }, "status": 301 },
    { "src": "/api/blog", "dest": "/api/blog.js" },
    { "src": "/api/board", "dest": "/api/board.js" },
    { "src": "/api/notice", "dest": "/api/notice.js" },
    { "src": "/api/cms", "dest": "/api/cms.js" },
    { "src": "/api/login", "dest": "/api/login.js" },
    { "src": "/api/inject", "dest": "/api/inject.js" },
    { "src": "/", "dest": "/api/inject" },
    { "src": "/index", "dest": "/api/inject" },
    { "src": "/index.html", "dest": "/api/inject" },
    { "src": "/index_v6.html", "dest": "/api/inject" },
    { "src": "/admin", "dest": "/admin.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
